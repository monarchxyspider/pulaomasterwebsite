{
  "rules": {
    "dishes": {
      ".read": true,
      ".write": "auth != null && (auth.token.email == 'raffaysweet@gmail.com' || auth.token.email == 'pulaomaster.com@gmail.com')"
    },
    "settings": {
      "public": {
        ".read": true,
        ".write": "auth != null && (auth.token.email == 'raffaysweet@gmail.com' || auth.token.email == 'pulaomaster.com@gmail.com')"
      }
    },
    "orders": {
      // Admin pure orders node ko ek sath fetch/listen kar sakta hai
      ".read": "auth != null && (auth.token.email == 'raffaysweet@gmail.com' || auth.token.email == 'pulaomaster.com@gmail.com')",
      
      "$orderId": {
        // Normal customer apna specific order read/confirm kar sakta hai
        ".read": true,
        // Normal customer naya order place kar sakta hai
        ".write": true
      }
    },
    "trackOrders": {
      "$orderId": {
        // Customer apna order status track kar sake
        ".read": true,
        // Customer new order tracking entry create kar sake, jabke Admin update bhi kar sake
        ".write": "!data.exists() || (auth != null && (auth.token.email == 'raffaysweet@gmail.com' || auth.token.email == 'pulaomaster.com@gmail.com'))"
      }
    },
    "chats": {
      "$orderId": {
        ".read": true,
        ".write": true
      }
    }
  }
}
